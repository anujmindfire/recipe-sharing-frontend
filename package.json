{
  "name": "recipe-sharing-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky install",
    "commitmsg": "commitlint -E HUSKY_GIT_PARAMS",
    "clean": "rm -rf node_modules && npm cache clean --force"
  },
  "lint-staged": {
    "*.ts": "eslint --fix",
    "*.tsx": "eslint --fix",
    "*.js": "eslint --fix",
    "*.json": "prettier --write"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@reduxjs/toolkit": "^2.3.0",
    "@types/dompurify": "^3.0.5",
    "antd": "^5.21.6",
    "axios": "^1.7.7",
    "cookie": "^1.0.1",
    "dompurify": "^3.1.7",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "next": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5"
  }
}
